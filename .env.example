# Current chat model: xAI Grok 4.7.
# LLM_MODEL uses LangChain init_chat_model's provider:model form.
# Documented providers:
#   xai:grok-4.7                  XAI_API_KEY           (current default)
#   anthropic:claude-sonnet-4-5   ANTHROPIC_API_KEY     (Claude)
#   openai:gpt-5.5                OPENAI_API_KEY
#   google_genai:gemini-2.5-pro   GOOGLE_API_KEY        (Gemini API)
LLM_MODEL=xai:grok-4.7

# Required for the current model (xAI)
XAI_API_KEY=your_xai_api_key_here

# Required for web search
TAVILY_API_KEY=your_tavily_api_key_here

# Set the key that matches LLM_MODEL when you switch providers.
# Claude:    pip install langchain-anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI:    pip install langchain-openai
# OPENAI_API_KEY=your_openai_api_key_here
# Gemini:    pip install langchain-google-genai
# GOOGLE_API_KEY=your_google_api_key_here

# Optional tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=gold-mining-framework
